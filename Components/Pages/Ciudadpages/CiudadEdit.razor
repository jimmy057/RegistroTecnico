@page "/Ciudad/Edit/{ciudadId:int}"
@inject CiudadServices ciudadService
@inject NavigationManager navigationManager
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<EditForm Model="@ciudad" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <div class="card shadow-lg border-0 rounded" style="background-color: #f8f9fa;">
        <div class="card-header bg-primary text-white text-center">
            <h3><i class="fas fa-city"></i> Editar Ciudad</h3>
        </div>

        <div class="card-body">
            @* ID de la Ciudad *@
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="CiudadId" class="form-label">ID Ciudad:</label>
                    <InputNumber @bind-Value="ciudad.CiudadId" class="form-control" disabled />
                </div>
            </div>

            @* Nombre de la Ciudad *@
            <div class="mb-3">
                <label for="Nombre" class="form-label">Nombre:</label>
                <InputText @bind-Value="ciudad.Name" class="form-control" />
                <ValidationMessage For="@(() => ciudad.Name)" />
            </div>
        </div>

        <div class="card-footer bg-light d-flex justify-content-between mt-3">
            <div class="btn-group">
                <button type="button" class="btn btn-outline-primary" @onclick="Nuevo">
                    <span class="bi bi-plus"></span> Nuevo
                </button>
                <button type="submit" class="btn btn-outline-success" @onclick="Guardar">
                    <span class="bi bi-check-circle-fill"></span> Guardar
                </button>
                <a href="/Ciudad/Index" class="btn btn-outline-danger">
                    <span class="bi bi-arrow-bar-left"></span> Retroceder
                </a>
                @* Botón de Eliminar *@
                <button type="button" class="btn btn-outline-danger" @onclick="Eliminar">
                    <span class="bi bi-trash"></span> Eliminar
                </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int? CiudadId { get; set; }
    public Ciudad ciudad { get; set; } = new Ciudad();

    protected override async Task OnInitializedAsync()
    {
        if (CiudadId.HasValue)
        {
            ciudad.CiudadId = CiudadId.Value;
            await Buscar();
        }
    }

    public void Nuevo()
    {
        ciudad = new Ciudad();
    }

    public async Task Buscar()
    {
        var ciudadEncontrada = await ciudadService.Buscar(ciudad.CiudadId);

        if (ciudadEncontrada != null)
        {
            ciudad = ciudadEncontrada;
        }
        else
        {
            navigationManager.NavigateTo("/Ciudad/Index");
        }
    }

    public async Task Guardar()
    {
        try
        {
            var guardo = await ciudadService.Modificar(ciudad);
            if (guardo)
            {
                Nuevo();
                navigationManager.NavigateTo("/Ciudad/Index");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar la ciudad: {ex.Message}");
        }
    }

    public async Task Eliminar()
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", new object[] { "¿Estás seguro de eliminar esta ciudad?" });
        if (confirm)
        {
            var eliminado = await ciudadService.Eliminar(ciudad.CiudadId);
            if (eliminado)
            {
                Nuevo();
                navigationManager.NavigateTo("/Ciudad/Index");
            }
        }
    }
}


